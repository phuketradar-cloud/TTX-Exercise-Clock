//@version=5
// Multi-Timeframe Price Range Boxes: M1 / M15 / H1 / H4 / D1
// วาดกรอบราคาสูงสุด/ต่ำสุดของแต่ละไทม์เฟรม ครอบอยู่ตรงตำแหน่งแท่งเทียนจริงของช่วงเวลานั้นบนกราฟ
// เมื่อช่วงเวลานั้นจบลง กรอบจะ "หยุดนิ่ง" ค้างอยู่ตรงตำแหน่งเดิมเป็นประวัติ (เหมือนภาพตัวอย่าง)
// แล้วเริ่มกรอบใหม่สำหรับช่วงเวลาถัดไป กรอบเก่าที่สุดจะถูกลบอัตโนมัติเมื่อเกิน max_boxes_count
indicator("MTF Range Boxes (M1/M15/H1/H4/D1)", shorttitle = "MTF Boxes", overlay = true, max_boxes_count = 100)

// ---------------- Inputs ----------------
grpM1  = "M1"
grpM15 = "M15"
grpH1  = "H1"
grpH4  = "H4"
grpD1  = "D1"

// เปิด/ปิด + สี ของแต่ละ TF อยู่บรรทัดเดียวกัน (inline) ภายใต้หัวข้อกลุ่มของตัวเอง
// เวลาเปิดหน้า Settings ของอินดิเคเตอร์ จะเห็นเป็นแถวแยกของแต่ละ TF ชัดเจนเหมือนแท็บ
// (Pine Script ไม่รองรับปุ่ม/แท็บคลิกบนกราฟโดยตรง ตัวเปิด-ปิดที่ทำได้จริงคือผ่าน Settings นี้)
showM1  = input.bool(true, "เปิดกรอบ M1",  group = grpM1,  inline = "M1")
colM1   = input.color(color.new(#FF00FF, 0), "สี", group = grpM1,  inline = "M1")  // ชมพูบานเย็น (magenta)

showM15 = input.bool(true, "เปิดกรอบ M15", group = grpM15, inline = "M15")
colM15  = input.color(color.new(#00FF66, 0), "สี", group = grpM15, inline = "M15") // เขียวมะนาวสด (lime)

showH1  = input.bool(true, "เปิดกรอบ H1",  group = grpH1,  inline = "H1")
colH1   = input.color(color.new(#FF9800, 0), "สี", group = grpH1,  inline = "H1")  // ส้ม

showH4  = input.bool(true, "เปิดกรอบ H4",  group = grpH4,  inline = "H4")
colH4   = input.color(color.new(#2196F3, 0), "สี", group = grpH4,  inline = "H4")  // ฟ้าสด

showD1  = input.bool(true, "เปิดกรอบ D1",  group = grpD1,  inline = "D1")
colD1   = input.color(color.new(#FF1744, 0), "สี", group = grpD1,  inline = "D1")  // แดงสด

// ---------------- ฟังก์ชันวาดกรอบราคาต่อ Timeframe ----------------
// หมายเหตุ: ตัวแปรที่ประกาศด้วย var ภายในฟังก์ชันนี้จะคงค่าแยกกันในแต่ละจุดที่เรียกใช้ฟังก์ชัน
// (แต่ละบรรทัดเรียกด้านล่างถือเป็นคนละ instance) จึงเก็บกรอบของแต่ละ TF แยกจากกันได้
// ใช้ if เดี่ยว (ไม่มี else) แยกแต่ละกรณี เพื่อเลี่ยงปัญหา "Return type ... is not compatible"
// ที่เกิดเมื่อแต่ละฝั่งของ if/else คืนค่าคนละชนิด
drawRangeBox(tfStr, boxColor, tfLabel, showBox) =>
    [h, l, t] = request.security(syminfo.tickerid, tfStr, [high, low, time], lookahead = barmerge.lookahead_off)

    var box b         = na
    var int startTime = na
    isNewPeriod = na(startTime) or t != startTime

    if showBox and isNewPeriod
        startTime := t
        b := box.new(left = t, top = h, bottom = l, right = time, xloc = xloc.bar_time,
             border_color = boxColor, border_width = 2, bgcolor = color.new(boxColor, 93),
             text = tfLabel, text_color = boxColor, text_size = size.small,
             text_halign = text.align_left, text_valign = text.align_top)

    if showBox and not isNewPeriod
        box.set_top(b, h)
        box.set_bottom(b, l)
        box.set_right(b, time)

    if not showBox
        if not na(b)
            box.delete(b)
            b := na

// ---------------- เรียกใช้งานแต่ละ Timeframe ----------------
// หมายเหตุ: ต้องวาดจากกรอบใหญ่สุด -> เล็กสุด (D1 ก่อน, M1 ทีหลังสุด) เพราะ Pine จะวาด
// ออบเจ็กต์ที่ถูกสร้างทีหลังทับอยู่บนของก่อนหน้าเสมอ ถ้าวาด M1/M15 ก่อน D1/H4 (ซึ่งมีขนาด
// ใหญ่กว่าและซ้อนทับพื้นที่เดียวกัน) กรอบเล็กจะถูกกรอบใหญ่ทับจนมองไม่เห็นขอบ
drawRangeBox("1D",  colD1,  "D1",  showD1)
drawRangeBox("240", colH4,  "H4",  showH4)
drawRangeBox("60",  colH1,  "H1",  showH1)
drawRangeBox("15",  colM15, "M15", showM15)
drawRangeBox("1",   colM1,  "M1",  showM1)

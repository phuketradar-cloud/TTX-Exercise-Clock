//@version=5
// Multi-Timeframe Price Range Boxes: M1 / M15 / H1 / H4 / D1
// วาดกล่องราคาสูงสุด/ต่ำสุดของแต่ละไทม์เฟรม ให้ "เกาะติด" อยู่ทางขวาของแท่งเทียนล่าสุดเสมอ
// (ไม่ลากยาวย้อนไปจากจุดเริ่มต้นของแต่ละไทม์เฟรม จึงไม่มีทางไปค้างอยู่ไกลจากราคาปัจจุบัน)
indicator("MTF Range Boxes (M1/M15/H1/H4/D1)", shorttitle = "MTF Boxes", overlay = true, max_boxes_count = 10)

// ---------------- Inputs ----------------
grpShow = "แสดง/ซ่อน"
grpCol  = "สีกรอบ"
grpBox  = "ขนาดกรอบ"

showM1  = input.bool(true, "M1",  group = grpShow, inline = "show")
showM15 = input.bool(true, "M15", group = grpShow, inline = "show")
showH1  = input.bool(true, "H1",  group = grpShow, inline = "show")
showH4  = input.bool(true, "H4",  group = grpShow, inline = "show")
showD1  = input.bool(true, "D1",  group = grpShow, inline = "show")

colM1  = input.color(color.aqua,   "M1",  group = grpCol, inline = "col")
colM15 = input.color(color.blue,   "M15", group = grpCol, inline = "col")
colH1  = input.color(color.orange, "H1",  group = grpCol, inline = "col")
colH4  = input.color(color.purple, "H4",  group = grpCol, inline = "col")
colD1  = input.color(color.red,    "D1",  group = grpCol, inline = "col")

boxWidth = input.int(4, "ความกว้างกรอบ (แท่ง)",         minval = 1, maxval = 30, group = grpBox)
boxGap   = input.int(2, "ระยะห่างระหว่างกรอบ (แท่ง)",   minval = 0, maxval = 30, group = grpBox)

// ---------------- ฟังก์ชันวาดกรอบราคา ----------------
// วาด/อัปเดตเฉพาะที่แท่งล่าสุด (barstate.islast) เท่านั้น และวางตำแหน่งอิงจาก
// bar_index ปัจจุบัน + slotIndex เสมอ กรอบจึงขยับตามไปกับแท่งเทียนล่าสุดตลอดเวลา
drawSlotBox(tfStr, boxColor, tfLabel, show, slotIndex) =>
    [h, l] = request.security(syminfo.tickerid, tfStr, [high, low], lookahead = barmerge.lookahead_off)

    var box b = na

    if barstate.islast and show
        leftBar  = bar_index + 1 + slotIndex * (boxWidth + boxGap)
        rightBar = leftBar + boxWidth
        txt = tfLabel + "\nH " + str.tostring(h, format.mintick) + "\nL " + str.tostring(l, format.mintick)
        if na(b)
            b := box.new(left = leftBar, top = h, bottom = l, right = rightBar, xloc = xloc.bar_index,
                 border_color = boxColor, border_width = 1, bgcolor = color.new(boxColor, 85),
                 text = txt, text_color = boxColor, text_size = size.small)
        if not na(b)
            box.set_left(b, leftBar)
            box.set_right(b, rightBar)
            box.set_top(b, h)
            box.set_bottom(b, l)
            box.set_text(b, txt)

    if barstate.islast and not show
        if not na(b)
            box.delete(b)
            b := na

// ---------------- เรียกใช้งานแต่ละ Timeframe (slotIndex 0-4 กันไม่ให้กรอบทับกัน) ----------------
drawSlotBox("1",   colM1,  "M1",  showM1,  0)
drawSlotBox("15",  colM15, "M15", showM15, 1)
drawSlotBox("60",  colH1,  "H1",  showH1,  2)
drawSlotBox("240", colH4,  "H4",  showH4,  3)
drawSlotBox("1D",  colD1,  "D1",  showD1,  4)

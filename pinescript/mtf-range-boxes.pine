//@version=5
// Multi-Timeframe Price Range Boxes: M1 / M15 / H1 / H4 / D1
// วาดกรอบราคา (High-Low box) ของแต่ละไทม์เฟรมทับบนชาร์ตหลัก พร้อมป้ายราคาสูงสุด/ต่ำสุด
indicator("MTF Range Boxes (M1/M15/H1/H4/D1)", shorttitle = "MTF Boxes", overlay = true, max_boxes_count = 60, max_labels_count = 60)

// ---------------- Inputs ----------------
grpM1  = "M1"
grpM15 = "M15"
grpH1  = "H1"
grpH4  = "H4"
grpD1  = "D1"
grpOpt = "ตั้งค่าทั่วไป"

showM1  = input.bool(true, "แสดงกรอบราคา M1",  group = grpM1)
showM15 = input.bool(true, "แสดงกรอบราคา M15", group = grpM15)
showH1  = input.bool(true, "แสดงกรอบราคา H1",  group = grpH1)
showH4  = input.bool(true, "แสดงกรอบราคา H4",  group = grpH4)
showD1  = input.bool(true, "แสดงกรอบราคา D1",  group = grpD1)

colM1  = input.color(color.new(color.aqua,   0), "สีกรอบ M1",  group = grpM1)
colM15 = input.color(color.new(color.blue,   0), "สีกรอบ M15", group = grpM15)
colH1  = input.color(color.new(color.orange, 0), "สีกรอบ H1",  group = grpH1)
colH4  = input.color(color.new(color.purple, 0), "สีกรอบ H4",  group = grpH4)
colD1  = input.color(color.new(color.red,    0), "สีกรอบ D1",  group = grpD1)

extendBars = input.int(3, "ระยะยื่นกรอบไปทางขวา (จำนวนแท่งของชาร์ตหลัก)", minval = 0, maxval = 100, group = grpOpt)
showLabel  = input.bool(true, "แสดงป้ายชื่อ Timeframe และราคา High/Low", group = grpOpt)

// ---------------- ฟังก์ชันวาดกรอบราคาต่อ Timeframe ----------------
// หมายเหตุ: ตัวแปรที่ประกาศด้วย var ภายในฟังก์ชันนี้จะคงค่าแยกกันในแต่ละจุดที่เรียกใช้ฟังก์ชัน
// (แต่ละบรรทัดเรียกด้านล่างถือเป็นคนละ instance) จึงสามารถเก็บ box/label ของแต่ละ TF แยกจากกันได้
drawRangeBox(tfStr, boxColor, tfLabel, showBox) =>
    [h, l, t] = request.security(syminfo.tickerid, tfStr, [high, low, time], lookahead = barmerge.lookahead_off)

    var box   b         = na
    var label lb        = na
    var int   startTime = na

    barSpacing = time - time[1]
    rightTime  = time + extendBars * (na(barSpacing) ? 0 : barSpacing)
    isNewPeriod = na(startTime) or t != startTime

    if showBox
        if isNewPeriod
            startTime := t
            b := box.new(left = t, top = h, bottom = l, right = rightTime, xloc = xloc.bar_time,
                 border_color = boxColor, border_width = 1, bgcolor = color.new(boxColor, 90))
            if not na(lb)
                label.delete(lb)
            lb := showLabel ? label.new(x = rightTime, y = h, xloc = xloc.bar_time,
                 text = tfLabel + "\nH: " + str.tostring(h, format.mintick) + "\nL: " + str.tostring(l, format.mintick),
                 style = label.style_label_left, color = color.new(boxColor, 0), textcolor = color.white, size = size.small) : na
        else
            box.set_top(b, h)
            box.set_bottom(b, l)
            box.set_right(b, rightTime)
            if not na(lb)
                label.set_xy(lb, rightTime, h)
                label.set_text(lb, tfLabel + "\nH: " + str.tostring(h, format.mintick) + "\nL: " + str.tostring(l, format.mintick))
    else
        if not na(b)
            box.delete(b)
            b := na
        if not na(lb)
            label.delete(lb)
            lb := na

// ---------------- เรียกใช้งานแต่ละ Timeframe ----------------
drawRangeBox("1",   colM1,  "M1",  showM1)
drawRangeBox("15",  colM15, "M15", showM15)
drawRangeBox("60",  colH1,  "H1",  showH1)
drawRangeBox("240", colH4,  "H4",  showH4)
drawRangeBox("1D",  colD1,  "D1",  showD1)
